module full_adder (input  a,input  b,input  cin,output sum,output cout);
assign sum  = a ^ b ^ cin;
assign cout = (a & b) | (b & cin) | (a & cin);
endmodule


module rca_4bit (input wire  [3:0]a,input wire [3:0]b,input cin,output [3:0]sum,output cout);

wire c1, c2, c3;

full_adder FA0(.a(a[0]),.b(b[0]),.cin(cin),.sum(sum[0]),.cout(c1));
full_adder FA1(.a(a[1]),.b(b[1]),.cin(c1),.sum(sum[1]),.cout(c2));
full_adder FA2(.a(a[2]),.b(b[2]),.cin(c2),.sum(sum[2]),.cout(c3));
full_adder FA3(.a(a[3]),.b(b[3]),.cin(c3),.sum(sum[3]),.cout(cout));

endmodule

module mux_4bit_2x1(a,b,sel,ou);
input wire [3:0] a,b;
input sel;
//output [3:0]ou;
output reg [3:0] ou;

always@(*) begin 
    case(sel)
        1'b0 : ou=a;
        1'b1 : ou=b;
        default : ou=4'bxxxx;
    endcase
end
//assign ou = sel?(a):(b);
endmodule 

module mux_8bit_2x1(a,b,sel,ou);
input [7:0] a,b;
input sel;
//output [7:0]ou;
output reg [7:0] ou;
always@(*) begin 
    case(sel)
        1'b0 : ou=a;
        1'b1 : ou=b;
        default : ou=8'hxx;
    endcase
end
//assign ou=sel?a:b;
endmodule 

module CSA_16bit(a,b,cin,sum,cout);

input wire [15:0] a,b;
input cin;
output [15:0]sum;
output cout;

wire c0,c1,c2;
wire c01,c11,c02,c12,c03,c13;
wire [3:0] temp01,temp11,temp12,temp02,temp03,temp13;
wire [7:0] lv2temp1,lv2temp2;

rca_4bit r1(.a(a[3:0]),.b(b[3:0]),.cin(cin),.sum(sum[3:0]),.cout(c0));
rca_4bit r2(a[7:4],b[7:4],0,temp01,c01);
rca_4bit r3(a[7:4],b[7:4],1,temp11,c11);
mux_4bit_2x1 mu1(temp01,temp11,c0,sum[7:4]);

rca_4bit r4(a[11:8],b[11:8],0,temp02,c02); 
rca_4bit r5(a[11:8],b[11:8],1,temp12,c12);   
rca_4bit r6(a[15:12],b[15:12],0,temp03,c03);
rca_4bit r7(a[15:12],b[15:12],1,temp13,c13);
//always @(*) begin
assign lv2temp1[3:0]=temp02;
assign lv2temp2[3:0]=temp12;
//end
mux_4bit_2x1 mu2(temp03,temp13,c02,lv2temp1[7:4]); 
mux_4bit_2x1 mu3(temp03,temp13,c12,lv2temp2[7:4]);
mux_8bit_2x1 legendmux(lv2temp1,lv2temp2,c1,sum[15:8]);
assign c1 = c0 ? c11 : c01;
assign c2 = c1 ? c12 : c02;
assign cout = c2 ? c13 : c03;
endmodule
